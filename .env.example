TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY= # gitleaks:allow
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_STRONG_MODEL=claude-sonnet-4-6
OPENAI_API_KEY= # gitleaks:allow
OPENAI_FAST_MODEL=gpt-5-mini
OPENAI_STRONG_MODEL=gpt-5.5
CODEX_FAST_MODEL=gpt-5.4-mini
CODEX_STRONG_MODEL=gpt-5.5
LLM_PROVIDER=codex
BANKROLL_USD=1000
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.02
RESEARCH_PROBE_PCT=0.005
CORE_DCA_PCT=0.01
MAX_ORDER_USD=25
MAX_DAILY_ORDER_COUNT=10
POLYMARKET_SCAN_ALERTS=false
ALLOW_EXTENDED_HOURS=false
ALLOW_TEST_ORDERS=false
LIVE_TRADING_ENABLED=false
EXECUTION_PROVIDER=internal_paper
EQUITY_RUNNER_MAX_RUNTIME_SECONDS=1800
POLITICIAN_INCLUDE_EXECUTIVE=false
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY= # gitleaks:allow
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk fuses (conservative / quarter-Kelly defaults — see README risk table)
EQUITY_MAX_NAME_PCT=0.25
EQUITY_MAX_SECTOR_PCT=0.35
# Gross exposure ceiling vs bankroll. 1.0 = cash-only, no broker margin. >1.0 = leverage.
EQUITY_MAX_GROSS_PCT=1.0
EQUITY_DAILY_LOSS_LIMIT_PCT=0.05
EQUITY_DRAWDOWN_LIMIT_PCT=0.15

# Correlation gate (see README risk table)
EQUITY_MAX_PAIRWISE_CORR=0.7
EQUITY_MAX_PORTFOLIO_CORR=0.5
EQUITY_CORRELATION_LOOKBACK_DAYS=90
EQUITY_CORRELATION_ENABLED=true

# Macro event blackout (FOMC/CPI/NFP — see README risk table)
EQUITY_NEWS_BLACKOUT_ENABLED=true
EQUITY_NEWS_BLACKOUT_BEFORE_H=24.0
EQUITY_NEWS_BLACKOUT_AFTER_H=2.0

# Mantle hackathon deployment.
# Use a dedicated deployer wallet with only the funds needed for testnet/mainnet gas.
# Never commit real private keys or funded wallet secrets.
# Sepolia default; switch to https://rpc.mantle.xyz for mainnet.
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
MANTLE_PRIVATE_KEY= # gitleaks:allow
AGENT_REGISTRY_ADDRESS=
AGENT_ID=mantle-verifiable-polymarket-agent
PUBLIC_COMMITMENTS_URL=
# API key for contract verification on Mantlescan (https://mantlescan.xyz)
MANTLESCAN_API_KEY=

# Data provider
TIINGO_API_KEY=
TRUTH_SOCIAL_API_KEY= # gitleaks:allow

# Frontend — set in Vercel dashboard for production builds
VITE_AGENT_REGISTRY_ADDRESS=
VITE_MANTLE_RPC_URL=https://rpc.mantle.xyz
VITE_MANTLE_EXPLORER_BASE=https://explorer.mantle.xyz
