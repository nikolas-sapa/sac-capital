<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polymarketbot.resolve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nikolassapalidis/polymarket-bot/.venv/bin/python</string>
        <string>-m</string>
        <string>core.resolution</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nikolassapalidis/polymarket-bot</string>

    <!-- Nightly resolution poll at 02:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nikolassapalidis/polymarket-bot/data/resolve.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nikolassapalidis/polymarket-bot/data/resolve.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/nikolassapalidis/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
