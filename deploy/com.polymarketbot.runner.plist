<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polymarketbot.runner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nikolassapalidis/polymarket-bot/.venv/bin/python</string>
        <string>runner.py</string>
        <string>--strategy</string>
        <string>weather,crypto_updown</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/nikolassapalidis/polymarket-bot</string>

    <!-- Scan cadence: every 300 seconds (5 min). Tune by editing this value
         and reloading: launchctl unload ... && launchctl load -w ... -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/nikolassapalidis/sapa_fund/data/runner.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nikolassapalidis/sapa_fund/data/runner.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/nikolassapalidis/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
